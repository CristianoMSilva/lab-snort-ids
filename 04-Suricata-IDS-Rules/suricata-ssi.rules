# Custom Suricata rules — Information Systems Security course (UNESP Bauru, Aug 2026)
# Authors: Cristiano Marques Silva, Augusto Cavalari
# Requires HOME_NET to include the monitored host (lab: 192.168.100.0/24) in suricata.yaml.

# 1. ICMP echo request (ping)
alert icmp any any -> any any (msg:"[SSI] Requisicao de Ping (ICMP) Detectada"; itype:8; sid:1000001; rev:2;)

# 2. Port scan: 15+ TCP SYN packets from the same source within 5 seconds
alert tcp any any -> $HOME_NET any (msg:"[SSI] Suspeita de Varredura de Portas (Port Scan)"; flags:S; threshold: type threshold, track by_src, count 15, seconds 5; sid:1000002; rev:1;)

# 3. SSH brute force: 5+ connection attempts to port 22 from the same source within 10 seconds
alert tcp any any -> $HOME_NET 22 (msg:"[SSI] Multiplas Tentativas de Conexao SSH (Forca Bruta)"; flags:S; threshold: type threshold, track by_src, count 5, seconds 10; sid:1000003; rev:1;)

# 4. HTTP request to a sensitive path
alert http any any -> $HOME_NET any (msg:"[SSI] Tentativa de Acesso a URL Suspeita (/admin)"; http.uri; content:"/admin"; sid:1000004; rev:1;)
